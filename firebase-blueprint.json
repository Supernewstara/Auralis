{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "neteaseId": { "type": "string" },
        "createdAt": { "type": "number", "description": "Server timestamp" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A single chat session containing recommendation logic and history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single prompt or recommendation result in a session",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "agent"] },
        "content": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["role", "content", "createdAt"]
    },
    "TasteMemory": {
      "title": "Taste Memory",
      "description": "A long-term memory fact about the user's music taste",
      "type": "object",
      "properties": {
        "fact": { "type": "string" },
        "category": { "type": "string", "enum": ["genre_preference", "artist_opinion", "personal_note", "feedback"] },
        "createdAt": { "type": "number", "description": "Server timestamp" }
      },
      "required": ["fact", "category", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile data."
    },
    "/users/{userId}/taste_memory/{memoryId}": {
      "schema": { "$ref": "#/entities/TasteMemory" },
      "description": "User's long term music taste memory."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "The user's chat sessions."
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages within a session."
    }
  }
}
